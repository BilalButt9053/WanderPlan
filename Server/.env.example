PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://localhost:27017/wanderplan
JWT_SECRET_KEY=replace-with-demo-secret

# Optional integrations. Keep real keys only in local .env files.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Optional email/upload settings
# Gmail SMTP requires an App Password, not your normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="WanderPlan <your-email@gmail.com>"
EMAIL_DEV_MODE=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BUSINESS_DASHBOARD_URL=http://localhost:5174
NGROK_URL=
